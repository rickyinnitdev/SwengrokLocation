{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wanderpenh",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-29",
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "PartyRoom" }, { "name": "RANKED", "class_name": "RankedPlayer" }] },
  // No database_id: Wrangler creates and binds this D1 database on first deploy.
  // The schema is created by the Worker itself (src/schema.js).
  "d1_databases": [{ "binding": "DB", "database_name": "wanderpenh-db" }],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PartyRoom"] }, { "tag": "v2", "new_sqlite_classes": ["RankedPlayer"] }],
  "observability": { "enabled": true }
}
